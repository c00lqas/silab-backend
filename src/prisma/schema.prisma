generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

model mst_user {
    id       String   @id @default(uuid())
    fullName String
    nim      String
    email    String
    password String
    role     UserRole
}

enum UserRole {
    MAHASISWA
    LABORAN
    ASISTEN
}
