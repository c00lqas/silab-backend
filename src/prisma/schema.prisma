generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

enum UserRole {
    MAHASISWA
    LABORAN
    ASISTEN
    DOSEN
}

enum ClassRoom {
    PSI
    SBTI
}

enum DaysOfWeek {
    MONDAY
    TUESDAY
    WEDNESDAY
    THURSDAY
    FRIDAY
}

model mst_user {
    id       String   @id @default(uuid())
    fullname String
    nim      String   @unique
    email    String   @unique
    password String
    role     UserRole

    subjectLecturer  mst_subject[]            @relation(name: "SubjectLecturer")
    subjectUpdatedBy mst_subject[]            @relation(name: "SubjectUpdatedBy")
    subjectCreatedBy mst_subject[]            @relation(name: "SubjectCreatedBy")
    classEnrollments trn_class_participants[] @relation(name: "UserEnrollments")

    @@index([id, nim])
}

model mst_subject {
    id           String    @id @default(uuid())
    subject_code String
    subject_name String
    semester     String
    lecturer_id  String
    updated_by   String?
    created_by   String
    updated_at   DateTime?
    created_at   DateTime? @default(now())
    deleted_at   DateTime?

    lecturer  mst_user  @relation(name: "SubjectLecturer", fields: [lecturer_id], references: [id])
    updatedBy mst_user? @relation(name: "SubjectUpdatedBy", fields: [updated_by], references: [id])
    createdBy mst_user  @relation(name: "SubjectCreatedBy", fields: [created_by], references: [id])

    @@index([id, subject_code])
}

model mst_class {
    id         String     @id @default(uuid())
    subjectId  String
    name       String
    quota      Int
    day        DaysOfWeek
    startAt    String
    endAt      String
    room       ClassRoom
    updated_by String?
    created_by String
    updated_at DateTime?
    created_at DateTime?  @default(now())
    deleted_at DateTime?

    participants trn_class_participants[] @relation(name: "ClassParticipants")

    @@index([id, subjectId])
}

model trn_class_participants {
    classId    String
    userId     String
    createdAt  DateTime  @default(now())
    updated_at DateTime?
    deleted_at DateTime?

    class mst_class @relation(name: "ClassParticipants", fields: [classId], references: [id])
    user  mst_user  @relation(name: "UserEnrollments", fields: [userId], references: [id])

    @@unique([classId, userId])
    @@index([classId, userId])
}
